rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExistingSet() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Tài khoản admin được xác định bằng tài liệu /admins/{uid} do Firebase Console
    // hoặc Admin SDK tạo. Client không có quyền tự thêm mình vào collection này.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isUserSubmission() {
      return request.resource.data.ownerId == request.auth.uid
        && request.resource.data.isPublic == false
        && request.resource.data.publicationStatus in ['private', 'pending'];
    }

    function isSafeUserUpdate() {
      return ownsExistingSet()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.isPublic == false
        && request.resource.data.publicationStatus in ['private', 'pending']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'words', 'isPublic', 'publicationStatus'
        ]);
    }

    match /study_sets/{setId} {
      // Chỉ bộ thẻ đã được admin duyệt (isPublic) mới hiện với cộng đồng.
      // Chủ sở hữu và admin vẫn xem được các bộ thẻ đang chờ duyệt.
      allow read: if resource.data.isPublic == true
        || (signedIn() && (ownsExistingSet() || isAdmin()));
      // User chỉ tạo bộ thẻ riêng tư hoặc gửi vào hàng chờ duyệt.
      allow create: if signedIn() && isUserSubmission();
      // User không thể tự đặt isPublic = true hoặc publicationStatus = approved.
      allow update: if isSafeUserUpdate()
        || (isAdmin() && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if ownsExistingSet() || isAdmin();
    }

    match /admins/{userId} {
      // Người dùng chỉ được kiểm tra quyền admin của chính họ.
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      // Chỉ Firebase Console hoặc Admin SDK được dùng để cấp / thu quyền admin.
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
                    && request.resource.data.userId == userId;
      allow update: if signedIn() && request.auth.uid == userId
                    && request.resource.data.userId == userId;
      allow delete: if isAdmin();
    }

    match /user_progress/{progressId} {
      // Tiến độ chỉ thuộc về đúng người dùng đã đăng nhập.
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;
    }
  }
}
